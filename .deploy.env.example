# Copy to .deploy.env and fill in. .deploy.env is git-ignored (holds host details).
#
#   cp .deploy.env.example .deploy.env
#
# Then run: ./deploy.sh

# --- SSH connection to the production server ---
SSH_HOST="www.marakarental.cz"
SSH_USER="your-ssh-user"
SSH_PORT="22"

# Absolute path to the Laravel app root ON THE SERVER (the folder containing
# artisan, app/, public/ …). NOT the public web root.
REMOTE_PATH="/home/your-ssh-user/www/reservations"

# Target PHP CLI on the server. Use the newest version supported by Laravel 11 +
# Filament 3 (PHP 8.2–8.4) — prefer 8.4. The server default may be newer (e.g.
# 8.5), which the stack does not officially target, so point this at 8.4.
# Find it on the server with:  ls /usr/local/bin | grep -iE 'php8|ea-php'
# Examples: "php84", "/usr/local/bin/php84", "/opt/alt/php84/usr/bin/php".
REMOTE_PHP="php84"

# Path to the Composer phar on the server. It is invoked AS `${REMOTE_PHP} <this>`
# so Composer also runs under PHP 8.2. Find it with:  which composer
REMOTE_COMPOSER="/usr/local/bin/composer"

# Ownership the web server needs. You connect as root, but files must be owned
# by the web user/group (typically www-data) to be served & writable correctly.
# The deploy sets this ownership during and after transfer.
WEB_USER="www-data"
WEB_GROUP="www-data"

# Set to 1 to put the site into maintenance mode during migrate/caching.
USE_MAINTENANCE_MODE="1"

# Set to 1 to run `php artisan migrate --force` on deploy. Leave 0 the first
# time if you prefer to import the DB manually, then flip to 1.
RUN_MIGRATIONS="1"
