# Copy to .deploy-ftp.env (git-ignored) and fill in. Used by ./deploy-ftp.sh.

FTP_HOST=ftp.example.cz
FTP_USER=
FTP_PASSWORD=
FTP_PROTOCOL=ftp          # ftp (TLS when offered) | ftps | sftp
FTP_PATH=/www             # folder the hosting serves as the web root
FTP_VERIFY_CERT=yes       # set to no only if the host's FTP certificate doesn't match its name

SITE_URL=https://www.marakarental.cz
MAINTENANCE_TOKEN=        # same value as MAINTENANCE_TOKEN in the server's .env

UPLOAD_ENV=0              # 1 = upload .env.production as the server's .env

# Before the DNS switch: reach the new server by IP (checks run over plain HTTP).
SITE_IP=

# One-off when moving hosts (leave empty otherwise):
MOVE_DUMP=                # gzip SQL dump of the old database -> imported into the EMPTY new DB
MOVE_MEDIA=               # local copy of the old storage/app/public (product photos)
