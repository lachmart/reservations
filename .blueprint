created:
    - database/factories/ProductFactory.php
    - database/factories/PortFactory.php
    - database/factories/CategoryFactory.php
    - database/factories/TagFactory.php
    - database/factories/ReservationFactory.php
    - database/factories/ReservationItemFactory.php
    - database/migrations/2025_01_31_171241_create_products_table.php
    - database/migrations/2025_01_31_171242_create_ports_table.php
    - database/migrations/2025_01_31_171243_create_categories_table.php
    - database/migrations/2025_01_31_171244_create_tags_table.php
    - database/migrations/2025_01_31_171245_create_reservations_table.php
    - database/migrations/2025_01_31_171246_create_reservation_items_table.php
    - database/migrations/2025_01_31_171247_create_port_product_table.php
    - database/migrations/2025_01_31_171248_create_product_tag_table.php
    - database/migrations/2025_01_31_171249_create_product_reservation_item_table.php
    - app/Models/Product.php
    - app/Models/Port.php
    - app/Models/Category.php
    - app/Models/Tag.php
    - app/Models/Reservation.php
    - app/Models/ReservationItem.php
models:
    User: { name: string, email: string, email_verified_at: 'datetime nullable', password: string, remember_token: 'string nullable' }
    Product: { name: string, description: longText, status: string, category_id: unsignedInteger, relationships: { belongsToMany: 'Port, Tag, ReservationItem', belongsTo: Category } }
    Port: { name: string, gender: 'enum:male,female', relationships: { belongsToMany: Product } }
    Category: { name: string, relationships: { hasMany: Product } }
    Tag: { name: string, relationships: { belongsToMany: Product } }
    Reservation: { name: string, email: string, start_date: datetime, end_date: datetime, note: string, is_active: 'bool default:false', is_paid: 'bool default:false', relationships: { hasMany: ReservationItem } }
    ReservationItem: { amount: integer, reservation_id: unsignedInteger, relationships: { belongsToMany: Product, belongsTo: Reservation } }
